<?xml version="1.0" encoding="utf-8"?>
<!--
  Local dev only. Android blocks plain HTTP by default since API 28. This
  scopes an exception to just the hosts a local Ulimi-app dev server is
  reached at, rather than allowing cleartext app-wide:
    - 10.0.2.2 is the Android emulator's fixed alias for the host machine's
      localhost (set the dart define API_BASE_URL to this when running
      against a dev server on the same PC as the emulator).
    - localhost/127.0.0.1 cover a physical device on the same machine via
      adb reverse, or running in a desktop/web target.
  Production (agrivault.bytebridgemw.tech) is always HTTPS and untouched.
  This config only ever grants an exception, never removes HTTPS elsewhere.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
